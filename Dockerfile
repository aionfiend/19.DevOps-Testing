# Используем легковесный образ Alpine
FROM alpine:3.18

# Устанавливаем curl (он понадобится для внутренних тестов, если применимо)
RUN apk add --no-cache curl

# Создаем безопасного пользователя (не root) с UID 1001
RUN adduser -D -u 1001 appuser

# Переключаемся на созданного пользователя
USER appuser

# Настраиваем простейший встроенный веб-сервер на порту 8080, который возвращает текстовые данные
CMD ["httpd", "-f", "-p", "8080", "-h", "/etc"]
